generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ======================== ENUMS ========================

enum Role {
  SUPER_ADMIN
  ADMIN_SIMPLE
  RESPONSABLE_ANTENNE
  ADMIN_ANTENNE
  PERSONNEL
  VOLONTAIRE
  MAJ
}

enum TypeActivite {
  PONCTUELLE
  PERIODIQUE
}

enum Frequence {
  MENSUELLE
  BIMENSUELLE
  BIMESTRIELLE
  TRIMESTRIELLE
  SEMESTRIELLE
  ANNUELLE
}

enum Periodicite {
  LUNDI
  MARDI
  MERCREDI
  JEUDI
  VENDREDI
  AVANT_JOUR_DU_MOIS
}

enum StatutActivite {
  NON_PLANIFIEE
  PLANIFIEE
  EN_COURS
  REALISEE
  EN_RETARD
  ANNULEE
  SUSPENDUE
  REPROGRAMMEE
}

enum SourceRecommandation {
  ACTIVITE
  REUNION
  SUPERVISION
  FORMATION
}

enum TypeResolution {
  PERMANENTE
  PONCTUELLE
  PERIODIQUE
}

enum StatutRecommandation {
  EN_ATTENTE
  EN_COURS
  PARTIELLEMENT_REALISEE
  RESOLUE
  EN_RETARD
  ANNULEE
}

enum Priorite {
  HAUTE
  MOYENNE
  BASSE
}

enum TypeJournee {
  FIXE
  VARIABLE
}

enum StatutPointage {
  PRESENT
  RETARD
  ABSENT
  CONGE
  MISSION
  ARRET_MALADIE
  ABSENCE_AUTORISEE
  ABSENCE_NON_AUTORISEE
  FERIE
}

enum TypeConge {
  ANNUEL
  MALADIE
  MATERNITE
  PATERNITE
  EXCEPTIONNEL
  SANS_SOLDE
}

enum StatutConge {
  BROUILLON
  SOUMIS
  APPROUVE_RESPONSABLE
  APPROUVE_FINAL
  REFUSE
  ANNULE
}

enum TypeNotification {
  ACTIVITE_EN_RETARD
  RECOMMANDATION_EN_RETARD
  CONGE_SOUMIS
  CONGE_APPROUVE
  CONGE_REFUSE
  ASSIGNATION_ACTIVITE
  ASSIGNATION_RECOMMANDATION
  RAPPEL_POINTAGE
  SYSTEME
}

enum ActionAudit {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  STATUS_CHANGE
}

enum EvenementEmpreinte {
  ENROLLMENT
  IDENTIFICATION_SUCCESS
  IDENTIFICATION_FAIL
  TEMPLATE_DELETED
  POINTAGE_ARRIVEE_BIOMETRIQUE
  POINTAGE_DEPART_BIOMETRIQUE
}

enum StatutMission {
  PLANIFIEE
  EN_COURS
  TERMINEE
  ANNULEE
}

enum StatutEvaluation {
  BROUILLON
  SOUMISE
  VALIDEE
}

// ======================== MODELS ========================

model Antenne {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nom       String   @unique
  code      String   @unique
  region    String
  ville     String
  adresse   String?
  telephone String?
  email     String?
  isActive  Boolean  @default(true)

  employes          User[]
  activiteAntennes  ActiviteAntenne[]
  recommandations   Recommandation[]
  projets           Projet[]

  @@map("antennes")
}

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nom       String
  prenom    String
  email     String   @unique
  username  String   @unique
  password  String
  telephone String?
  role      Role     @default(PERSONNEL)
  isActive  Boolean  @default(true)
  image     String?
  theme     String   @default("light")

  antenneId String?
  antenne   Antenne? @relation(fields: [antenneId], references: [id])

  typeJournee      TypeJournee @default(FIXE)
  heureDebutFixe   String?     @default("08:00")
  heureFinFixe     String?     @default("16:00")
  empreinteEnrolee Boolean     @default(false)

  pointages                    Pointage[]
  congesDemandes               Conge[]                       @relation("CongeEmploye")
  congesApprouves              Conge[]                       @relation("CongeApprobateur")
  activiteAntennes             ActiviteAntenne[]             @relation("ResponsableActivite")
  recommandationResponsables   RecommandationResponsable[]
  notifications                Notification[]
  auditLogs                    AuditLog[]
  activitesCreees              Activite[]                    @relation("CreateurActivite")
  empreintes                   Empreinte[]
  empreintesEnrolees           Empreinte[]                   @relation("EmpreinteEnrolledBy")
  empreinteLogs                EmpreinteLog[]                @relation("EmpreinteLogUser")
  empreinteLogsAdmin           EmpreinteLog[]                @relation("EmpreinteLogAdmin")

  // Nouvelles relations
  dateEmbauche                 DateTime?
  typeContrat                  String?
  dateFinContrat               DateTime?
  poste                        String?
  service                      String?
  soldeCongesAnnuel            Int         @default(30)

  missionsResponsable          Mission[]                     @relation("MissionResponsable")
  missionsCreees               Mission[]                     @relation("MissionCreateur")
  formations                   FormationParticipant[]
  evaluationsEmploye           EvaluationPerformance[]       @relation("EvaluationEmploye")
  evaluationsEvaluateur        EvaluationPerformance[]       @relation("EvaluationEvaluateur")
  permissions                  UserPermission[]

  @@map("users")
}

// ======================== PERMISSIONS ========================

model UserPermission {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId     String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission String

  @@unique([userId, permission])
  @@index([userId])
  @@map("user_permissions")
}

model Projet {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  code        String   @unique
  nom         String
  description String?
  dateDebut   DateTime
  dateFin     DateTime?
  budget      Float?
  typeFonds   String?
  bailleur    String?
  isActive    Boolean  @default(true)

  antenneId String?
  antenne   Antenne? @relation(fields: [antenneId], references: [id])

  activites Activite[]

  @@map("projets")
}

model Activite {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  titre           String
  description     String?
  type            TypeActivite
  frequence       Frequence?
  periodicite     Periodicite?
  jourPeriodicite Int?
  statut          StatutActivite @default(NON_PLANIFIEE)
  dateDebut    DateTime?
  dateFin      DateTime?
  dateRealisee DateTime?
  budget       Float?
  observations String?

  projetId   String?
  projet     Projet?  @relation(fields: [projetId], references: [id])
  createurId String
  createur   User     @relation("CreateurActivite", fields: [createurId], references: [id])

  activiteAntennes ActiviteAntenne[]
  recommandations  Recommandation[]
  historiques      ActiviteHistorique[]

  @@map("activites")
}

model ActiviteAntenne {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activiteId    String
  activite      Activite @relation(fields: [activiteId], references: [id], onDelete: Cascade)
  antenneId     String
  antenne       Antenne  @relation(fields: [antenneId], references: [id], onDelete: Cascade)
  responsableId String?
  responsable   User?    @relation("ResponsableActivite", fields: [responsableId], references: [id])

  statut      StatutActivite @default(PLANIFIEE)
  commentaire String?

  periodes ActiviteAntennePeriode[]

  @@unique([activiteId, antenneId])
  @@map("activite_antennes")
}

model ActiviteAntennePeriode {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activiteAntenneId String
  activiteAntenne   ActiviteAntenne @relation(fields: [activiteAntenneId], references: [id], onDelete: Cascade)

  dateDebut    DateTime
  dateFin      DateTime
  statut       StatutActivite @default(PLANIFIEE)
  dateRealisee DateTime?
  commentaire  String?

  @@map("activite_antenne_periodes")
}

model ActiviteHistorique {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  activiteId    String
  activite      Activite       @relation(fields: [activiteId], references: [id], onDelete: Cascade)
  ancienStatut  StatutActivite
  nouveauStatut StatutActivite
  commentaire   String?
  modifiePar    String

  @@map("activite_historiques")
}

model Recommandation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  titre          String
  description    String
  source         SourceRecommandation
  typeResolution TypeResolution
  statut         StatutRecommandation @default(EN_ATTENTE)
  priorite       Priorite             @default(MOYENNE)
  dateEcheance   DateTime
  dateResolution    DateTime?
  frequence         Frequence?
  tauxMiseEnOeuvre    Int            @default(0)
  observations        String?
  dernierResetPeriode DateTime?

  activiteId String?
  activite   Activite? @relation(fields: [activiteId], references: [id])
  antenneId  String?
  antenne    Antenne?  @relation(fields: [antenneId], references: [id])

  responsables RecommandationResponsable[]
  historiques  RecommandationHistorique[]

  @@map("recommandations")
}

model RecommandationResponsable {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  recommandationId String
  recommandation   Recommandation @relation(fields: [recommandationId], references: [id], onDelete: Cascade)
  userId           String
  user             User           @relation(fields: [userId], references: [id])
  isPrincipal      Boolean        @default(false)

  @@unique([recommandationId, userId])
  @@map("recommandation_responsables")
}

model RecommandationHistorique {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  recommandationId String
  recommandation   Recommandation       @relation(fields: [recommandationId], references: [id], onDelete: Cascade)
  ancienStatut     StatutRecommandation
  nouveauStatut    StatutRecommandation
  commentaire      String?
  modifiePar       String

  @@map("recommandation_historiques")
}

model Pointage {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  date          DateTime       @db.Date
  heureArrivee  DateTime?
  pauseDebut    DateTime?
  pauseFin      DateTime?
  heureDepart   DateTime?
  totalHeures   Float          @default(0)
  statut        StatutPointage @default(PRESENT)
  retardMinutes Int            @default(0)
  heuresSupp    Float          @default(0)
  observations  String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("pointages")
}

model Conge {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  type                   TypeConge
  statut                 StatutConge @default(BROUILLON)
  dateDebut              DateTime
  dateFin                DateTime
  nbJours                Int
  motif                  String
  commentaireApprobateur String?

  employeId     String
  employe       User      @relation("CongeEmploye", fields: [employeId], references: [id])
  approbateurId String?
  approbateur   User?     @relation("CongeApprobateur", fields: [approbateurId], references: [id])
  dateApprobation DateTime?

  @@map("conges")
}

model Notification {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  type    TypeNotification
  titre   String
  message String
  lue     Boolean @default(false)
  lien    String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lue])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  action       ActionAudit
  entite       String
  entiteId     String?
  details      String?
  previousData String?    @db.Text
  ipAddress    String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([entite, entiteId])
  @@index([userId])
  @@map("audit_logs")
}

// ======================== BIOMETRIE ========================

model Empreinte {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  templateData String  @db.Text
  doigt        Int
  qualite      Int
  actif        Boolean @default(true)

  userId       String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrolledById String
  enrolledBy   User   @relation("EmpreinteEnrolledBy", fields: [enrolledById], references: [id])

  @@unique([userId, doigt])
  @@map("empreintes")
}

model EmpreinteLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  evenement EvenementEmpreinte
  score     Int?
  details   String?

  userId  String?
  user    User?   @relation("EmpreinteLogUser", fields: [userId], references: [id])
  adminId String?
  admin   User?   @relation("EmpreinteLogAdmin", fields: [adminId], references: [id])

  @@index([userId])
  @@index([evenement])
  @@map("empreinte_logs")
}

// ======================== MISSIONS ========================

model Mission {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  objet        String
  lieu         String
  dateDebut    DateTime
  dateFin      DateTime
  perDiem      Float?
  statut       StatutMission @default(PLANIFIEE)
  observations String?
  rapportMission String?     @db.Text

  responsableId String
  responsable   User   @relation("MissionResponsable", fields: [responsableId], references: [id])
  createurId    String
  createur      User   @relation("MissionCreateur", fields: [createurId], references: [id])

  @@map("missions")
}

// ======================== FORMATIONS ========================

model Formation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  titre       String
  description String?
  organisme   String?
  lieu        String?
  dateDebut   DateTime
  dateFin     DateTime
  cout        Float?

  participants FormationParticipant[]

  @@map("formations")
}

model FormationParticipant {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  formationId String
  formation   Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  attestation Boolean   @default(false)

  @@unique([formationId, userId])
  @@map("formation_participants")
}

// ======================== EVALUATION PERFORMANCE ========================

model EvaluationPerformance {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  periode      String
  dateEval     DateTime
  statut       StatutEvaluation @default(BROUILLON)
  noteGlobale  Float?
  commentaire  String?          @db.Text
  objectifs    String?          @db.Text
  pointsForts  String?          @db.Text
  axesProgres  String?          @db.Text

  employeId    String
  employe      User   @relation("EvaluationEmploye", fields: [employeId], references: [id])
  evaluateurId String
  evaluateur   User   @relation("EvaluationEvaluateur", fields: [evaluateurId], references: [id])

  @@map("evaluations_performance")
}
